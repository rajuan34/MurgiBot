# ==========================================
# MANDATORY / CORE VARIABLES (Render Setup)
# ==========================================

# DISCORD_TOKEN: Bot token from Discord Developer Portal
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# GEMINI_API_KEY: Google AI Studio API key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Secondary fallback provider (Optional but recommended)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# DeepSeek V4 Flash 0731: Ultra-fast MoE, ultra-cheap ($0.006/1M tokens)
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"

# ==========================================
# RENDER PRODUCTION & SERVER SETTINGS
# ==========================================

# NODE_ENV: Set to production on Render
NODE_ENV="production"

# PORT: Render sets this automatically (e.g. 10000)
PORT="10000"

# RENDER_EXTERNAL_URL: Your Render service URL (e.g. https://your-bot.onrender.com)
# Used for automatic keep-alive self-ping to prevent 15-minute sleep
RENDER_EXTERNAL_URL="https://your-app-name.onrender.com"

# APP_URL: Fallback URL if RENDER_EXTERNAL_URL is not provided
APP_URL="https://your-app-name.onrender.com"

# ADMIN_PASSWORD: Protects web dashboard and admin endpoints
ADMIN_PASSWORD="YourSecureAdminPassword123"

# ==========================================
# DISCORD CHANNELS & SCHEDULES
# ==========================================

# ALLOWED_CHANNEL_IDS: Comma-separated channel IDs where bot is permitted to respond
ALLOWED_CHANNEL_IDS="705092446366728236,1453357071931019304,1470329659693600768"

# SCHEDULED_SERVER_ID: Discord Guild ID where daily scheduled messages are sent
SCHEDULED_SERVER_ID="705092446366728233"

# Daily Schedule Time & Zone (24h format HH:mm)
TIMEZONE="Asia/Dhaka"
SCHEDULE_1="15:30"
SCHEDULE_2="22:30"

# ==========================================
# PERSISTENCE (Optional PostgreSQL)
# ==========================================
# DATABASE_URL: PostgreSQL connection URI (Optional - bot uses built-in memory fallback if empty)
DATABASE_URL=""


